
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>JHC — SERIOUSLY UNSERIOUS</title>

    <style>
        /* =========================
           RESET
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Arial,
                "Noto Sans TC",
                "Microsoft JhengHei",
                sans-serif;
            background: #f5f5f1;
            color: #111;
            line-height: 1.5;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            width: 100%;
            display: block;
        }


        /* =========================
           HEADER
        ========================= */

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 80px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 5vw;

            background: rgba(245, 245, 241, 0.9);
            backdrop-filter: blur(15px);

            z-index: 999;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        }

        .logo {
            font-size: 25px;
            font-weight: 900;
            letter-spacing: -1px;
        }

        .logo span {
            font-weight: 400;
        }

        nav {
            display: flex;
            gap: 35px;
        }

        nav a {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            position: relative;
        }

        nav a::after {
            content: "";
            position: absolute;
            bottom: -6px;
            left: 0;
            width: 0;
            height: 2px;
            background: #111;
            transition: 0.3s;
        }

        nav a:hover::after {
            width: 100%;
        }

        .menu-btn {
            display: none;
            font-size: 24px;
            cursor: pointer;
        }


        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 100vh;

            padding: 150px 5vw 70px;

            display: flex;
            flex-direction: column;
            justify-content: space-between;

            position: relative;
            overflow: hidden;
        }

        .hero-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .hero-small {
            font-size: 12px;
            letter-spacing: 2px;
            font-weight: 700;
        }

        .hero-number {
            font-size: 12px;
            letter-spacing: 2px;
        }

        .hero-title {
            margin-top: 80px;
            max-width: 1100px;
        }

        .hero-title h1 {
            font-size: clamp(70px, 13vw, 190px);
            line-height: 0.82;
            letter-spacing: -9px;
            font-weight: 900;
        }

        .hero-title h1 span {
            display: block;
            margin-left: 9vw;
        }

        .hero-bottom {
            display: flex;
            justify-content: space-between;
            align-items: end;
            margin-top: 80px;
        }

        .hero-description {
            max-width: 350px;
            font-size: 14px;
        }

        .hero-description strong {
            font-size: 18px;
        }

        .scroll {
            font-size: 11px;
            letter-spacing: 2px;
        }

        .star {
            position: absolute;

            width: 180px;
            height: 180px;

            right: 8%;
            top: 38%;

            background: #e9ff00;

            clip-path: polygon(
                50% 0%,
                61% 35%,
                100% 50%,
                61% 65%,
                50% 100%,
                39% 65%,
                0% 50%,
                39% 35%
            );

            animation: rotateStar 15s linear infinite;
        }

        @keyframes rotateStar {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }


        /* =========================
           SECTION
        ========================= */

        section {
            padding: 130px 5vw;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: end;

            margin-bottom: 70px;

            border-bottom: 1px solid #111;
            padding-bottom: 20px;
        }

        .section-number {
            font-size: 12px;
            font-weight: 700;
        }

        .section-title {
            font-size: clamp(45px, 7vw, 90px);
            font-weight: 900;
            letter-spacing: -5px;
            line-height: 0.9;
        }


        /* =========================
           COLLECTION
        ========================= */

        .products {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .product {
            position: relative;
            cursor: pointer;
            overflow: hidden;
        }

        .product-image {
            aspect-ratio: 4 / 5;
            background: #deded9;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;
        }

        .product-image::before {
            content: "JHC";

            font-size: 100px;
            font-weight: 900;

            color: #111;

            transition: 0.5s;
        }

        .product:nth-child(2) .product-image {
            background: #e9ff00;
        }

        .product:nth-child(3) .product-image {
            background: #111;
        }

        .product:nth-child(3) .product-image::before {
            color: #f5f5f1;
        }

        .product:hover .product-image::before {
            transform: scale(1.2) rotate(-8deg);
        }

        .product-info {
            padding: 18px 0;

            display: flex;
            justify-content: space-between;

            border-bottom: 1px solid #111;
        }

        .product-name {
            font-weight: 800;
            font-size: 14px;
        }

        .product-price {
            font-size: 13px;
        }


        /* =========================
           BRAND STORY
        ========================= */

        .story {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10vw;
            align-items: center;
        }

        .story-big {
            font-size: clamp(40px, 5vw, 75px);
            line-height: 0.95;
            font-weight: 800;
            letter-spacing: -3px;
        }

        .story-big span {
            color: #777;
        }

        .story-text {
            max-width: 480px;
            font-size: 16px;
        }

        .story-text p {
            margin-bottom: 25px;
        }

        .highlight {
            display: inline-block;
            background: #e9ff00;
            padding: 3px 8px;
            font-weight: 800;
        }


        /* =========================
           BRAND VALUES
        ========================= */

        .values {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            border-top: 1px solid #111;
            border-left: 1px solid #111;
        }

        .value {
            min-height: 280px;
            padding: 35px;

            border-right: 1px solid #111;
            border-bottom: 1px solid #111;

            display: flex;
            flex-direction: column;
            justify-content: space-between;

            transition: 0.3s;
        }

        .value:hover {
            background: #111;
            color: #f5f5f1;
        }

        .value-number {
            font-size: 12px;
        }

        .value h3 {
            font-size: 30px;
            letter-spacing: -1px;
        }

        .value p {
            font-size: 13px;
            max-width: 300px;
        }


        /* =========================
           JHC WORLD
        ========================= */

        .world {
            background: #111;
            color: #f5f5f1;

            min-height: 700px;

            display: flex;
            flex-direction: column;
            justify-content: space-between;

            position: relative;
            overflow: hidden;
        }

        .world .section-header {
            border-color: #f5f5f1;
        }

        .world-content {
            position: relative;
            z-index: 2;
        }

        .world-title {
            font-size: clamp(70px, 12vw, 170px);
            font-weight: 900;
            letter-spacing: -8px;
            line-height: 0.8;
        }

        .world-description {
            max-width: 400px;
            margin-top: 50px;
            font-size: 15px;
        }

        .world-star {
            position: absolute;
            width: 500px;
            height: 500px;

            right: -100px;
            bottom: -100px;

            background: #e9ff00;

            clip-path: polygon(
                50% 0%,
                61% 35%,
                100% 50%,
                61% 65%,
                50% 100%,
                39% 65%,
                0% 50%,
                39% 35%
            );

            transform: rotate(20deg);
        }


        /* =========================
           JOURNAL
        ========================= */

        .journal {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .journal-card {
            min-height: 330px;

            border: 1px solid #111;

            padding: 30px;

            display: flex;
            flex-direction: column;
            justify-content: space-between;

            transition: 0.3s;
        }

        .journal-card:hover {
            background: #e9ff00;
            transform: translateY(-8px);
        }

        .journal-card h3 {
            font-size: 42px;
            line-height: 0.9;
            letter-spacing: -2px;
        }

        .journal-card p {
            font-size: 14px;
            max-width: 400px;
        }


        /* =========================
           ROADMAP
        ========================= */

        .roadmap {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .roadmap-item {
            border-top: 3px solid #111;
            padding-top: 20px;
        }

        .roadmap-year {
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 35px;
        }

        .roadmap-item h3 {
            font-size: 32px;
            margin-bottom: 20px;
        }

        .roadmap-item p {
            font-size: 14px;
            max-width: 300px;
        }


        /* =========================
           FOOTER
        ========================= */

        footer {
            background: #111;
            color: #f5f5f1;

            padding: 80px 5vw 30px;
        }

        .footer-title {
            font-size: clamp(70px, 15vw, 200px);
            font-weight: 900;
            letter-spacing: -10px;
            line-height: 0.8;
        }

        .footer-info {
            margin-top: 100px;

            display: flex;
            justify-content: space-between;

            border-top: 1px solid #555;
            padding-top: 20px;

            font-size: 12px;
        }

        .footer-social {
            display: flex;
            gap: 25px;
        }


        /* =========================
           SCROLL ANIMATION
        ========================= */

        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: 0.8s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 900px) {

            nav {
                display: none;
            }

            .menu-btn {
                display: block;
            }

            .hero-title h1 {
                letter-spacing: -5px;
            }

            .star {
                width: 100px;
                height: 100px;
                right: 5%;
            }

            .products {
                grid-template-columns: 1fr 1fr;
            }

            .story {
                grid-template-columns: 1fr;
                gap: 50px;
            }

            .values {
                grid-template-columns: 1fr;
            }

            .roadmap {
                grid-template-columns: 1fr;
                gap: 50px;
            }
        }


        @media (max-width: 600px) {

            header {
                height: 65px;
                padding: 0 20px;
            }

            section {
                padding: 90px 20px;
            }

            .hero {
                padding: 120px 20px 50px;
            }

            .hero-title {
                margin-top: 100px;
            }

            .hero-title h1 {
                font-size: 20vw;
                letter-spacing: -3px;
            }

            .hero-title h1 span {
                margin-left: 0;
            }

            .hero-bottom {
                flex-direction: column;
                align-items: flex-start;
                gap: 40px;
            }

            .products {
                grid-template-columns: 1fr;
            }

            .journal {
                grid-template-columns: 1fr;
            }

            .section-title {
                letter-spacing: -3px;
            }

            .world-title {
                letter-spacing: -5px;
            }

            .world-star {
                width: 250px;
                height: 250px;
            }

            .footer-title {
                letter-spacing: -5px;
            }

            .footer-info {
                flex-direction: column;
                gap: 20px;
            }
        }
    </style>
</head>


<body>

    <!-- =========================
         HEADER
    ========================== -->

    <header>

        <a href="#" class="logo">
            JHC<span>.</span>
        </a>

        <nav>
            <a href="#collection">COLLECTION</a>
            <a href="#about">ABOUT</a>
            <a href="#world">JHC WORLD</a>
            <a href="#journal">JOURNAL</a>
            <a href="#future">FUTURE</a>
        </nav>

        <div class="menu-btn">
            ☰
        </div>

    </header>



    <!-- =========================
         HERO
    ========================== -->

    <main>

        <section class="hero">

            <div class="hero-top">

                <div class="hero-small">
                    JIN-HO-CHILL
                </div>

                <div class="hero-number">
                    EST. 2026 / TAIWAN
                </div>

            </div>


            <div class="hero-title reveal">

                <h1>
                    SERIOUSLY
                    <span>UNSERIOUS.</span>
                </h1>

            </div>


            <div class="hero-bottom">

                <div class="hero-description">

                    <strong>
                        正經ㄉ胡鬧
                    </strong>

                    <br><br>

                    生活已經夠認真了，
                    <br>
                    穿搭就不要太正經。

                </div>

                <div class="scroll">
                    SCROLL TO EXPLORE ↓
                </div>

            </div>


            <div class="star"></div>

        </section>



        <!-- =========================
             COLLECTION
        ========================== -->

        <section id="collection">

            <div class="section-header reveal">

                <div class="section-number">
                    01 / COLLECTION
                </div>

                <h2 class="section-title">
                    基礎不基本
                </h2>

            </div>


            <div class="products">

                <div class="product reveal">

                    <div class="product-image"></div>

                    <div class="product-info">

                        <div class="product-name">
                            JHC BASIC TEE
                        </div>

                        <div class="product-price">
                            NT$ 890
                        </div>

                    </div>

                </div>


                <div class="product reveal">

                    <div class="product-image"></div>

                    <div class="product-info">

                        <div class="product-name">
                            ANGRY STAR TEE
                        </div>

                        <div class="product-price">
                            NT$ 980
                        </div>

                    </div>

                </div>


                <div class="product reveal">

                    <div class="product-image"></div>

                    <div class="product-info">

                        <div class="product-name">
                            SERIOUSLY HOODIE
                        </div>

                        <div class="product-price">
                            NT$ 1,680
                        </div>

                    </div>

                </div>

            </div>

        </section>



        <!-- =========================
             ABOUT
        ========================== -->

        <section id="about">

            <div class="section-header reveal">

                <div class="section-number">
                    02 / ABOUT
                </div>

                <h2 class="section-title">
                    WHY JHC?
                </h2>

            </div>


            <div class="story">

                <div class="story-big reveal">

                    做自己，
                    <br>

                    <span>不要演別人。</span>

                </div>


                <div class="story-text reveal">

                    <p>
                        JHC 金厚秋，是一個結合
                        <span class="highlight">生活風格 × 街頭休閒服飾</span>
                        的品牌。
                    </p>

                    <p>
                        我們相信生活已經夠嚴肅，
                        所以衣服不用再替你增加壓力。
                    </p>

                    <p>
                        用幽默包裝現實，
                        用輕鬆對抗生活。
                    </p>

                    <p>
                        JHC 不只是衣服，
                        更是一種「笑著過生活」的態度。
                    </p>

                </div>

            </div>

        </section>



        <!-- =========================
             VALUES
        ========================== -->

        <section>

            <div class="section-header reveal">

                <div class="section-number">
                    03 / PHILOSOPHY
                </div>

                <h2 class="section-title">
                    JHC MINDSET
                </h2>

            </div>


            <div class="values">

                <div class="value reveal">

                    <div class="value-number">
                        01
                    </div>

                    <h3>
                        DO YOURSELF.
                    </h3>

                    <p>
                        做自己，比扮演別人更重要。
                        穿衣服不是為了迎合，
                        而是表達自己的方式。
                    </p>

                </div>


                <div class="value reveal">

                    <div class="value-number">
                        02
                    </div>

                    <h3>
                        DON'T BE TOO SERIOUS.
                    </h3>

                    <p>
                        人生已經夠認真，
                        所以我們決定讓衣服
                        不那麼正經。
                    </p>

                </div>


                <div class="value reveal">

                    <div class="value-number">
                        03
                    </div>

                    <h3>
                        HUMOR IS AN ATTITUDE.
                    </h3>

                    <p>
                        幽默不是敷衍，
                        而是一種面對生活的方式。
                    </p>

                </div>

            </div>

        </section>



        <!-- =========================
             JHC WORLD
        ========================== -->

        <section id="world" class="world">

            <div class="section-header">

                <div class="section-number">
                    04 / JHC WORLD
                </div>

                <div>
                    MR. CHILL
                </div>

            </div>


            <div class="world-content reveal">

                <div class="world-title">
                    秋哥.
                </div>

                <div class="world-description">

                    JHC 的虛擬角色。

                    <br><br>

                    有點厭世，
                    有點懶，
                    有點荒謬。

                    <br><br>

                    但沒關係。

                    <br>

                    今天也很好笑。

                </div>

            </div>


            <div class="world-star"></div>

        </section>



        <!-- =========================
             JOURNAL
        ========================== -->

        <section id="journal">

            <div class="section-header reveal">

                <div class="section-number">
                    05 / JOURNAL
                </div>

                <h2 class="section-title">
                    STORIES
                </h2>

            </div>


            <div class="journal">

                <article class="journal-card reveal">

                    <div>
                        01 / BRAND
                    </div>

                    <h3>
                        今天也很好笑。
                    </h3>

                    <p>
                        生活很忙，
                        但我們還是決定笑一下。
                    </p>

                </article>


                <article class="journal-card reveal">

                    <div>
                        02 / STYLE
                    </div>

                    <h3>
                        WEAR YOUR MOOD.
                    </h3>

                    <p>
                        衣服不只是穿搭，
                        也是你今天想成為什麼樣子的選擇。
                    </p>

                </article>


                <article class="journal-card reveal">

                    <div>
                        03 / STREET
                    </div>

                    <h3>
                        STREET,
                        <br>
                        BUT CHILL.
                    </h3>

                    <p>
                        街頭不一定要很兇，
                        也可以很輕鬆。
                    </p>

                </article>


                <article class="journal-card reveal">

                    <div>
                        04 / HUMOR
                    </div>

                    <h3>
                        LIFE'S A JOKE.
                    </h3>

                    <p>
                        既然人生有時候很荒謬，
                        那就把荒謬穿在身上。
                    </p>

                </article>

            </div>

        </section>



        <!-- =========================
             FUTURE
        ========================== -->

        <section id="future">

            <div class="section-header reveal">

                <div class="section-number">
                    06 / FUTURE
                </div>

                <h2 class="section-title">
                    WHAT'S NEXT?
                </h2>

            </div>


            <div class="roadmap">

                <div class="roadmap-item reveal">

                    <div class="roadmap-year">
                        SHORT TERM / 1 YEAR
                    </div>

                    <h3>
                        BUILD
                    </h3>

                    <p>
                        建立 JHC 品牌識別，
                        發展代表性插畫角色，
                        建立穩定的小型服飾系列。
                    </p>

                </div>


                <div class="roadmap-item reveal">

                    <div class="roadmap-year">
                        MID TERM / 2–3 YEARS
                    </div>

                    <h3>
                        EXPAND
                    </h3>

                    <p>
                        發展帽子、襪子、帆布袋等生活配件，
                        推出主題系列，
                        建立品牌故事與社群。
                    </p>

                </div>


                <div class="roadmap-item reveal">

                    <div class="roadmap-year">
                        LONG TERM / 3–5 YEARS
                    </div>

                    <h3>
                        BECOME
                    </h3>

                    <p>
                        完整建立 JHC IP 世界，
                        發展跨品牌、藝術家與不同領域合作，
                        成為具有代表性的青年街頭生活品牌。
                    </p>

                </div>

            </div>

        </section>

    </main>



    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <div class="footer-title">
            JHC.
        </div>

        <div class="footer-info">

            <div>
                SERIOUSLY UNSERIOUS
                <br>
                正經ㄉ胡鬧
            </div>

            <div class="footer-social">

                <a href="#">
                    INSTAGRAM
                </a>

                <a href="#">
                    TIKTOK
                </a>

                <a href="#">
                    THREADS
                </a>

            </div>

            <div>
                © 2026 JIN-HO-CHILL
            </div>

        </div>

    </footer>



    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        /*
        ============================
        SCROLL REVEAL
        ============================
        */

        const reveals = document.querySelectorAll(".reveal");

        function revealOnScroll() {

            reveals.forEach((element) => {

                const windowHeight = window.innerHeight;

                const elementTop =
                    element.getBoundingClientRect().top;

                const revealPoint = 100;

                if (elementTop < windowHeight - revealPoint) {

                    element.classList.add("active");

                }

            });

        }

        window.addEventListener(
            "scroll",
            revealOnScroll
        );

        revealOnScroll();



        /*
        ============================
        MOBILE MENU
        ============================
        */

        const menuButton =
            document.querySelector(".menu-btn");

        const nav =
            document.querySelector("nav");

        menuButton.addEventListener(
            "click",
            () => {

                if (nav.style.display === "flex") {

                    nav.style.display = "none";

                } else {

                    nav.style.display = "flex";

                    nav.style.position = "absolute";
                    nav.style.top = "65px";
                    nav.style.left = "0";

                    nav.style.width = "100%";

                    nav.style.padding = "30px 20px";

                    nav.style.flexDirection = "column";

                    nav.style.background = "#f5f5f1";

                }

            }
        );



        /*
        ============================
        PRODUCT CLICK
        ============================
        */

        const products =
            document.querySelectorAll(".product");

        products.forEach((product) => {

            product.addEventListener(
                "click",
                () => {

                    alert(
                        "JHC 商品頁面｜COMING SOON"
                    );

                }
            );

        });

    </script>

</body>
</html>